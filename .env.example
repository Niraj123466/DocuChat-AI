# ==============================================================================
# DocuChat-AI Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME=DocuChat-AI
APP_VERSION=2.0.0
ENVIRONMENT=development                # development | production | test
DEBUG=true
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# 2. AI & LLM SERVICES (Required for Live RAG)
# ------------------------------------------------------------------------------
# Google Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Guardrails AI cloud token
GUARDRAILS_API_KEY=

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (Required for Live Pinecone Vector Search)
# ------------------------------------------------------------------------------
# Pinecone API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-bot
PINECONE_REGION=us-east-1

# Two-stage retrieval thresholds
RAG_TOP_K=5                            # Dense candidate chunks retrieved
RAG_SCORE_THRESHOLD=0.40               # Minimum similarity cutoff
MAX_RETRIES=3                          # LangGraph self-correction loop limit

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (Required for JWT & RBAC)
# ------------------------------------------------------------------------------
# 32+ character random secret string (e.g. generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-with-a-secure-random-32-char-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# Allowed CORS origins for frontend (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5175,*

# ------------------------------------------------------------------------------
# 5. DATABASE & PERSISTENCE (SQLite local or PostgreSQL)
# ------------------------------------------------------------------------------
# Default: zero-config async SQLite in project root
DATABASE_URL=sqlite+aiosqlite:///./docuchat.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://docuchat:docuchat_secure_pass@localhost:5432/docuchat_db

# ------------------------------------------------------------------------------
# 6. CACHING (Redis with automatic In-Memory fallback)
# ------------------------------------------------------------------------------
# Leave as default; if Redis is not running, automatic thread-safe in-memory cache is used
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. WHATSAPP WEBHOOK INTEGRATION (Optional - only if using Meta WhatsApp Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=docuchat_verify_token_prod
WHATSAPP_APP_SECRET=
